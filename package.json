{
  "name": "parc-rennes",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "data:import": "node --import tsx scripts/import-rennes.ts",
    "data:plan": "node --import tsx scripts/import-park-plan.ts",
    "data:thabor": "node --import tsx scripts/import-thabor-plan.ts",
    "data:thabor:trees": "node --import tsx scripts/import-thabor-trees.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.7.34",
    "cesium": "1.120.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "tsx": "^4.20.6",
    "vite": "^6.4.3",
    "vite-plugin-cesium": "^1.2.23"
  },
  "engines": { "node": ">=20.11.0" }
}
